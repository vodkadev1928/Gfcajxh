Boomer Shooter 3D Mobile html, body { margin: 0; padding: 0; overflow: hidden; background: #000; } #ui { position: fixed; inset: 0; pointer-events: none; } .btn { position: absolute; width: 80px; height: 80px; border-radius: 50%; background: rgba(255,255,255,.15); pointer-events: auto; touch-action: none; } #stick { left: 20px; bottom: 20px; } #shoot { right: 20px; bottom: 20px; } #cross { position:absolute; left:50%; top:50%; width:10px; height:10px; transform:translate(-50%,-50%); border:2px solid #fff; border-radius:50%; } 

// ====== CENA ====== const scene = new THREE.Scene(); scene.background = new THREE.Color(0x202020); const camera = new THREE.PerspectiveCamera(75, innerWidth / innerHeight, 0.1, 1000); camera.position.set(0, 1.6, 5); const renderer = new THREE.WebGLRenderer({ antialias: true }); renderer.setSize(innerWidth, innerHeight); document.body.appendChild(renderer.domElement); // ====== LUZ ====== const light = new THREE.DirectionalLight(0xffffff, 1); light.position.set(5, 10, 5); scene.add(light, new THREE.AmbientLight(0xffffff, .3)); // ====== MAPA SIMPLES ====== const floor = new THREE.Mesh( new THREE.PlaneGeometry(50, 50), new THREE.MeshStandardMaterial({ color: 0x444444 }) ); floor.rotation.x = -Math.PI / 2; scene.add(floor); const wallMat = new THREE.MeshStandardMaterial({ color: 0x777777 }); function wall(x, z, w=5, h=3, d=1){ const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), wallMat); m.position.set(x, h/2, z); scene.add(m); } wall(0, -5, 10, 3, 1); wall(5, 0, 1, 3, 10); wall(-5, 0, 1, 3, 10); // ====== INIMIGO BÁSICO ====== const enemy = new THREE.Mesh( new THREE.BoxGeometry(1,2,1), new THREE.MeshStandardMaterial({ color: 0xaa0000 }) ); enemy.position.set(0,1,-10); scene.add(enemy); // ====== CONTROLES ====== let move = { x:0, z:0 }; const stick = document.getElementById('stick'); stick.addEventListener('touchmove', e=>{ const t = e.touches[0]; const r = stick.getBoundingClientRect(); move.x = (t.clientX - (r.left+r.width/2)) / 40; move.z = (t.clientY - (r.top+r.height/2)) / 40; }); stick.addEventListener('touchend', ()=> move={x:0,z:0}); // ====== SHOTGUN ====== const shootBtn = document.getElementById('shoot'); shootBtn.addEventListener('touchstart', shoot); function shoot(){ const dir = new THREE.Vector3(); camera.getWorldDirection(dir); const ray = new THREE.Raycaster(camera.position, dir); const hit = ray.intersectObject(enemy); if(hit.length){ enemy.material.color.set(0x000000); } } // ====== LOOP ====== function animate(){ requestAnimationFrame(animate); camera.position.x += move.x * 0.05; camera.position.z += move.z * 0.05; renderer.render(scene, camera); } animate(); addEventListener('resize', ()=>{ camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); }); 
